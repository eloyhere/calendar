{
    "name": "calendar",
    "version": "1.0.0",
    "description": "An Electron application with Vue and TypeScript",
    "main": "./out/main/index.js",
    "author": "example.com",
    "homepage": "https://electron-vite.org",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "lint:fix": "eslint --cache --fix .",
        "icons": "node scripts/build-icons.cjs",
        "smoke": "node scripts/smoke.mts",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "verify:nav": "node scripts/verify-nav.mjs && node scripts/verify-nav-selftest.mjs",
        "verify:icons": "node scripts/verify-icons.mjs",
        "verify:structure": "node scripts/verify-structure.mjs",
        "verify": "npm run verify:nav && npm run verify:icons && npm run verify:structure",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run verify && npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "deploy": "npm run icons && electron-vite build && electron-builder --win msi",
        "build:unpack": "npm run build && npm run icons && electron-builder --dir",
        "build:mac": "npm run build && npm run icons && electron-builder --mac",
        "build:linux": "npm run build && npm run icons && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@element-plus/icons-vue": "^2.3.2",
        "astronomy-engine": "^2.1.19",
        "d3-array": "^3.2.4",
        "d3-geo": "^3.1.1",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "d3-time-format": "^4.1.0",
        "echarts": "^6.1.0",
        "electron-updater": "^6.3.9",
        "element-plus": "^2.14.7",
        "pinia": "^4.0.3",
        "three": "^0.186.1",
        "topojson-client": "^3.1.0",
        "vue-router": "^5.4.0",
        "world-atlas": "^2.0.2"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@types/d3-array": "^3.2.2",
        "@types/d3-geo": "^3.1.1",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.2.0",
        "@types/node": "^22.19.1",
        "@types/three": "^0.186.0",
        "@types/topojson-client": "^3.1.5",
        "@vitejs/plugin-vue": "^6.0.2",
        "electron": "^39.2.6",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-vue": "^10.6.2",
        "prettier": "^3.7.4",
        "typescript": "^5.9.3",
        "vite": "^7.2.6",
        "vue": "^3.5.25",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.1.6"
    }
}
